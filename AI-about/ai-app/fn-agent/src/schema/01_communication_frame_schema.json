{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frame:F-COMM-00:v1-candidate",
  "metadata": {
    "frame_schema_id": "F-COMMUNICATION-SCHEMA-00",
    "frame_schema_name": "F-COMMUNICATION-SCHEMA",
    "evocation": "channel_turn",
    "parent": null,
    "description": "发送方通过媒介向接收方传递信息（转移图式[Agent,Theme,Goal]）,作为入口框架，所有与Agent的交互都被封装为这种交流事件",
    "event_type": "turn_envelope",
    "event_note": "此框架实例代表一个话轮对话的抽象容器，其中包裹了具体的被激活的框架和域内容",
    "lu_inventory": [],
    "lu_note": "非词元根框架（对齐FrameNet设计）；通知/告知/提醒/转告待日志抽取后挂力量子框架",
    "frame_relationship": null,
    "type": "frame"
  },

    "core_fe":{
      "communicator": {
        "semantic_role": "Agent",
        "type": "entity_ref", 
        "enum": ["ENT-HUMAN", "ENT-SYSTEM", "ENT-GROUP"], 
        "qualia_projection": "Agentive",
        "null_instantiation": "INI",
        "default_on_missing": "ENT-GUEST",
        "note": "INI(上游无信息)缺省填充ENT-GUEST"
      },
      "addressee": {
        "semantic_role": "Goal",
        "type": "entity_ref", 
        "enum": ["ENT-HUMAN", "ENT-SYSTEM", "ENT-GROUP"], 
        "qualia_projection": "Telic",
        "note": "不限定system: 转告场景Addressee=ENT-GROUP(群实体)；入口场景的'恒为自身'是实例层缺省注入，非类型约束"
      },
      "message": {
        "semantic_role": "Theme",
        "note": "嵌入宿主？不透明SoA或force_frame_schema",
        "oneOf": [
          { "type": "string", "note": "opaque SoA, 未解析/寒暄/本系统边界外" },
          {
            "type": "object",
            "required": ["force_frame_schema_id"],
            "properties": {
              "force_frame_schema_id": {
                "enum": ["F-COMM-01-Request", "F-COMM-02-Command",
                        "F-COMM-03-Question", "F-COMM-04-Statement",
                        "F-COMM-05-Commitment"]
              },
              "force_frame_instance_id": { "type": "string", "format": "uuid" },
              "content": {
                "oneOf": [
                  { "type": "string", "note": "域内容不透明" },
                  { "$ref": "#/$defs/frame_instance_ref", "note": "域框架实例" }
                ]
              }
            }
          }
        ]
      },
      "medium": {
        "semantic_role": "channel",
        "type": "entity_ref",
        "entity_schemas": ["ENT-SYSTEM", "ENT-GROUP"],
        "qualia_projection": "Constitutive",
        "note": "升核心:转告场景agent自身(例如将消息转发给他人)=Medium; Medium决定force_frame缺省解读"
      }
    },

    "peripheral_fe":{
      "topic": {"type": "string"},
      "manner": {"type": "string"},
      "language": {"type": "string"},
      "source": { 
        "type": "entity_ref", 
        "entity_schemas": ["ENT-HUMAN", "ENT-SYSTEM"],
        "note": "转告链原始说话者"
      }
    },

    "frame_rules": {
      "routing": "content承载域框架的Telic ⊆ addressee.qualia.Telic；不满足→转交/反问",
      "deontic_hook": "speaker.qualia.Formal × 域框架类型 → allow/deny/escalate；动作执行层统一执行，全通道（含兜底）共用",
      "embedding_depth": 2,
      "recursion_limit": "Communication嵌Communication ≤1层（转告）",
      "regression_anchor": [
        "任意入站话轮构造实例 frame_schema_id == F-COMM-00",
        "'门禁不通过'类话语解析结果 frame_schema_id == F-CHECK-01"
      ]
    },

    "$defs": {
      "frame_instance_ref": {
        "type": "object",
        "required": ["frame_schema_id"],
        "properties": {
          "frame_schema_id":    { "type": "string" },
          "frame_instance_id":  { "type": "string", "format": "uuid" },
          "core_fe":            { "type": "object" }
        }
      }
    },

    "instance_template": {
      "description": "每入站话轮实例化一次; uuid只在这一层生成; FE槽位结构复用core_fe/peripheral_fe",
      "properties": {
        "frame_instance_id":  { "type": "string", "format": "uuid", "generator": "uuid4" },
        "frame_schema_id":    { "const": "F-COMM-00" },
        "in_response_to":     { "type": ["string", "null"], "format": "uuid" },
        "utterance":          { "type": "string", "note": "原始话轮文本,禁止拼接qualia" },
        "created_at":         { "type": "string", "format": "date-time" }
      },
      "required": ["frame_instance_id", "frame_schema_id", "addressee", "message"]
    }
}
