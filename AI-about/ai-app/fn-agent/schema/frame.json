{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:struct:frame:v1",
  "title": "frame (v1) 框架结构",
  "description": "基于framenet原生frame.xsd进行设计和补充，用于描述领域框架",
  "version": "v1",

  "$defs": {
    "domain_sem_type": {
      "type": "object",
      "description": "领域语义标签，继承framenet的语义标签进行扩展, 当前(2026/9/23)原生语义类型可以约束领域，V1版本不扩展",
      "allOf": [{ "$ref": "urn:struct:specTypes:v1#/$defs/sem_type_ref" }]
    },
    "fe_schema": {
      "type": "object",
      "description": "FE的schema设计, 包含有7个framenet定义的原生属性，一个补充属性用于具体业务(可选)",
      "required": ["id", "name", "create_time", "core_type", "definition"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:fe:[A-Z]+(?:-[A-Z]+)*-00:v[0-9]+(-[a-z][a-z0-9]*)?$"
        },
        "name": { "$ref": "urn:struct:specTypes:v1#/$defs/property_name_type" },
        "abbrev": { "type": "string", "description": "别名" },
        "definition": { "type": "string" },
        "core_type": { "$ref": "urn:struct:specTypes:v1#/$defs/core_type" },
        "sem_type": { "$ref": "urn:struct:specTypes:v1#/$defs/sem_type_ref" },
        "create_time": { "$ref": "urn:struct:specTypes:v1#/$defs/iso8601" },
        "additional_usage": {
          "type": "object",
          "description": "用于约束具体领域场景下，1.fe的语义类型、2.填充源的候选路径、3...",
          "required": ["domain_sem_type"],
          "properties": {
            "domain_sem_type": {"$ref": "#/$defs/domain_sem_type"}
          }
        }
      }
    },

    "lu_schema": {
      "type": "object",
      "description": "LU的schema设计, 包含有10个framenet定义的原生属性，一个补充属性用于具体业务(可选)",
      "required": ["id", "name", "create_time", "definition", "sem_type", "lexeme"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:lu:[A-Z]+(?:-[A-Z]+)*-00:v[0-9]+(-[a-z][a-z0-9]*)?$"
        },
        "name": { "$ref": "urn:struct:specTypes:v1#/$defs/property_name_type" },
        "definition": { "type": "string" },
        "sem_type": { "$ref": "urn:struct:specTypes:v1#/$defs/sem_type_ref" },
        "create_time": { "$ref": "urn:struct:specTypes:v1#/$defs/iso8601" },   
        "lexeme": { "$ref": "urn:struct:specTypes:v1#/$defs/lexeme_type" }           
      }
    }
  },
  
  "type": "object",
  "description": "frame结构",
  "required": ["$schema", "$id", "definition", "fe", "lus"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:frame:[A-Z]+(?:-[A-Z]+)*-00:v[0-9]+(-[a-z][a-z0-9]*)?$"
    },
    "name": { "$ref": "urn:struct:specTypes:v1#/$defs/frameNameType" },
    "create_time": { "$ref": "urn:struct:specTypes:v1#/$defs/iso8601"},
    "definition": {"type": "string", "description": "框架定义描述，句式：刻画/描述...."},
    "fe": {
      "type": "array",
      "items": { "$ref": "#/$defs/fe_schema" }
    },
    "lus": {
      "type": "array",
      "items": { "$ref": "#/$defs/lu_schema" }      
    },
    "lus_zh": {
      "type": "array",
      "description": "中文词元清单，与 lus 建议一一对应（本系统双语扩展）。",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
