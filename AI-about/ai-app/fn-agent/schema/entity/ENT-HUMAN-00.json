{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:entity:ENT-HUMAN-00:v1",
  "metadata" :{
    "entity_schema_id": "ENT-HUMAN-00",
    "entity_schema_name": "ENT-HUMAN",
    "parent": null,
    "description": "人类实体",
    "type": "entity",
    "version": "v1",
    "external_refs": [
      {
        "target_schema_id": "ENT-VERSION-00",
        "source_file": "./ENT-VERSION-00.json",
        "source_version": "v1",
        "imported_at": "2026-09-10"
      },
      {
        "target_schema_id": "ENT-PRODUCT-00",
        "source_file": "./ENT-PRODUCT-00.json",
        "source_version": "v1",
        "imported_at": "2026-09-10"
      }
  ]

  },

  "qualia": {
    "formal": {
      "is_a": "human",
      "features": {
        "user_id": { "type": "string", "is_required": true },
        "user_name": { "type": "string", "is_required": true }
      }
    },

    "telic": {
      "note": "描述人类实体在域内的位置/活动",
      "agent_semantic": {
          "part_of_domain":{
            "$ref": "#/$defs/part_of_domains"
          },
          "participate_in_domain": {
            "type": "object",
            "note": "域内的长期活动画像; 开放标签集合, 跨对话追加合并, 不覆盖",
            "candidates": ["create", "modify", "request", "command"],
            "properties": {
              "labels": { "type": "array", "items": { "type": "string" } },
              "as_of": { "type": "string", "format": "date-time" }
            }
          },
          "attention_point": {
            "type": "array",
            "note": "人类实体的意图收敛关注点(自由文本≤3条); 由历史对话总结, AI协作时应特别留意; 与习惯标签(interaction_habit)双轨",
            "items": { "type": "string" },
            "maxItems": 3
          },
          "interaction_habit": {
            "type": "object",
            "note": "人类实体的对话习惯(Dialogue Act, top_k≤3); 从历史对话总结, 用于后续AI生成风格; 与关注点(attention_point)双轨",
            "candidates": ["request", "question", "statement"],
            "properties": {
              "top_k": { "type": "array", "items": { "type": "string" }, "maxItems": 3 }
            }
          }
      },
      "patient_semantic": { 
        "type": "object", 
        "note": "为异步协作长任务设计;适用团队协作场景（如端到端的版本迭代）作为被委托方对承诺方做出承诺，出现此标签并被AI识别时，自动创建一条commitment_event",
        "fix_value": "commitment"
      }
    },

    "agentive": {
      "note": "描述人类实体经历过的领域事件以及承诺完成的领域事件",
      "history": { 
        "type": "array",
        "description_format": "{user_id} {user_name} 在 {timestamp} {action} {}"
      },
      "commitment_event": {
        "type": "array",
        "items": { "type": "object" },
        "note": "承诺完成的领域事件; 出现commitment=true并识别后自动创建, 随对话追加"
      }
    }
  },

  "$defs":{
    "part_of_domains": {
      "note": "域内责任田，粒度=版本",
      "entity_relation": [
        {
          "relation_type": "has_versions",
          "target_schema_id": "ENT-VERSION-00",
          "cardinality": "one_to_many"
        },
        {
          "relation_type": "has_products",
          "target_schema_id": "ENT-PRODUCT-00",
          "cardinality": "one_to_many"
        }
      ]
    }
  },

 "instance_template": {
   "description": "仅查无此人时例化一次; uuid只在这一层生成; 随对话迭代追加事件; 话轮上下文不落实体，落在agentive事件上",
   "properties": {
     "entity_instance_id": { "type": "string", "format": "uuid", "generator": "uuid4" },
     "frame_schema_id":    { "const": "ENT-HUMAN-00" },
     "user_id":            { "type": "string", "note": "formal.features.user_id" },
     "user_name":          { "type": "string", "note": "formal.features.user_name" },
     "part_of_domain":     { "$ref": "#/$defs/part_of_domains", "note": "telic.agent_semantic.part_of_domain" },
      "participate_in_domain": {
        "type": "object",
        "note": "telic.agent_semantic.participate_in_domain",
        "properties": {
          "labels": { "type": "array", "items": { "type": "string" } },
          "as_of": { "type": "string", "format": "date-time" }
        }
      },
     "attention_point": {
       "type": "array",
       "items": { "type": "string" },
       "maxItems": 3,
       "note": "telic.agent_semantic.attention_point, ≤3条自由文本"
     },
     "interaction_habit": {
       "type": "object",
       "note": "telic.agent_semantic.interaction_habit",
       "properties": {
         "top_k": { "type": "array", "items": { "type": "string" }, "maxItems": 3 }
       }
     },
     "commitment": {
       "type": "boolean",
       "note": "telic.patient_semantic; 被委托方对承诺方做承诺, 出现true时自动创建一条commitment_event"
     },
     "history": {
       "type": "array",
       "note": "agentive.history; 经历过的领域事件, 随对话追加",
       "items": {
         "type": "object",
         "required": ["timestamp", "action"],
         "properties": {
           "timestamp": { "type": "string", "format": "date-time" },
           "action":    { "type": "string" },
           "payload":   { "type": "object" }
         }
       }
     },
     "commitment_event": {
       "type": "array",
       "note": "agentive.commitment_event; 承诺完成的领域事件, 随对话追加",
       "items": { "type": "object" }
     },
     "created_at":   { "type": "string", "format": "date-time", "note": "实例落盘时刻; 允许早于created_at的追溯事件回填" },
     "time_updated": { "type": "string", "format": "date-time" }
   },
   "required": ["entity_instance_id", "frame_schema_id", "user_id", "user_name", "created_at"]
  }
}
