{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:registry:entity-registry:v1",
  "metadata": {
    "name": "entity-registry",
    "version": "v1",
    "description": "Entity 注册表模式。定义 Entity / QualiaInstance / EntityRelation 的字段结构与约束。",
    "scope": "domain-layer/entity 的实例数据",
    "layer": "domain-layer/entity"
  },

  "external_refs": [
    {
      "target_schema_id": "entity-spec",
      "source_file": "./specs/entity-spec.json",
      "source_version": "v1",
      "imported_at": "2026-09-15",
      "usage": "引用通用约束、命名、校验规则"
    },
    {
      "target_schema_id": "entity-attribute-index",
      "source_file": "./entity/entity-attribute-index.json",
      "source_version": "v1",
      "imported_at": "2026-09-15",
      "usage": "引用 attributes 定义"
    },
    {
      "target_schema_id": "relation-type-index",
      "source_file": "./entity/relation-type-index.json",
      "source_version": "v1",
      "imported_at": "2026-09-15",
      "usage": "引用关系类型清单"
    },
    {
      "target_schema_id": "R-ROLES-00",
      "source_file": "./registries/R-ROLES-00.json",
      "source_version": "v1-draft",
      "imported_at": "2026-09-15",
      "usage": "引用 EntityType.values"
    }
  ],

  "registry_structure": {
    "EntityRegistry": {
      "entities": {
        "type": "Entity[]",
        "required": true
      }
    },
    "Entity": {
      "id":         "string",
      "type":       "string",
      "name":       "string",
      "qualia":     "QualiaInstance",
      "attributes": "object",
      "state":      "string",
      "relations":  "EntityRelation[]",
      "domain":     "string",
      "tags":       "string[]"
    },
    "QualiaInstance": {
      "formal":       "string",
      "constitutive": "string[]",
      "telic":        "string[]",
      "agentive":     "string[]"
    },
    "EntityRelation": {
      "id":         "string",
      "type":       "string",
      "target":     "string",
      "label":      "string",
      "direction":  "string",
      "weight":     "number",
      "confidence": "number",
      "source":     "string",
      "evidence":   "string[]",
      "created_at": "string",
      "updated_at": "string",
      "valid_from": "string"
    }
  },

  "field_constraints": {
    "Entity": {
      "id": {
        "required": true,
        "pattern": "^entity:[A-Z][A-Za-z]+:[A-Za-z0-9._-]+$"
      },
      "type": {
        "required": true,
        "ref": "./registries/R-ROLES-00.json#/roles/EntityType/values"
      },
      "name": {
        "required": true,
        "type": "string",
        "max_length": 256
      },
      "qualia": {
        "required": true,
        "ref": "QualiaInstance"
      },
      "attributes": {
        "required": false,
        "ref": "./entity/entity-attribute-index.json#/attribute_index/{type}"
      },
      "state": {
        "required": false,
        "type": "string"
      },
      "relations": {
        "required": false,
        "ref": "EntityRelation[]"
      },
      "domain": {
        "required": false,
        "enum": ["general", "ci"]
      },
      "tags": {
        "required": false,
        "type": "array",
        "items": "string"
      }
    },
    "QualiaInstance": {
      "formal": {
        "required": true,
        "type": "string"
      },
      "constitutive": {
        "required": false,
        "type": "array",
        "items": "string"
      },
      "telic": {
        "required": true,
        "type": "array",
        "items": "string"
      },
      "agentive": {
        "required": true,
        "type": "array",
        "items": "string"
      }
    },
    "EntityRelation": {
      "id": {
        "required": true,
        "pattern": "^rel:[0-9]+$"
      },
      "type": {
        "required": true,
        "ref": "./entity/relation-type-index.json#/relation_types"
      },
      "target": {
        "required": true,
        "ref": "Entity.id"
      },
      "label": {
        "required": false,
        "type": "string",
        "max_length": 256
      },
      "direction": {
        "required": false,
        "enum": ["outbound", "inbound", "bidirectional"],
        "default": "outbound"
      },
      "weight": {
        "required": false,
        "type": "number",
        "min": 0,
        "max": 1
      },
      "confidence": {
        "required": false,
        "type": "number",
        "min": 0,
        "max": 1
      },
      "source": {
        "required": false,
        "enum": ["explicit", "inferred", "imported"]
      },
      "evidence": {
        "required": false,
        "type": "array",
        "items": "string"
      },
      "created_at": {
        "required": false,
        "format": "ISO8601"
      },
      "updated_at": {
        "required": false,
        "format": "ISO8601"
      },
      "valid_from": {
        "required": false,
        "format": "ISO8601-date"
      }
    }
  },

  "validation_rules_ref": "见 ./specs/entity-spec.json#/validation_rules",

  "conventions": {
    "required_entity_fields_ref":   "见 ./specs/entity-spec.json#/conventions/required_entity_fields",
    "required_qualia_fields_ref":   "见 ./specs/entity-spec.json#/conventions/required_qualia_fields",
    "required_relation_fields_ref": "见 ./specs/entity-spec.json#/conventions/required_relation_fields",
    "registry_container": "EntityRegistry.entities 为 Entity[] 顶层列表，required = true",
    "relation_storage": "relation 内嵌于 Entity.relations，不单独注册",
    "cross_file_refs": "文档级引用；不作为 JSON Schema $ref"
  }
}