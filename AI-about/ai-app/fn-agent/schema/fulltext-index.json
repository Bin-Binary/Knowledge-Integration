{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:struct:fulltext-index:v1",
  "title": "fulltext-index (v1) 全文索引结构",
  "description": "全文索引文档（fulltextIndex）的纯结构设计，对齐 FrameNet fulltextIndex.xsd：根 fulltextIndex 含 0 或多个 corpus（corpDocType，来自 header.xsd）。corpus 结构与 full_text 的 corpus 图例一致，仅承载 ID/name/description + document 序列的索引形态。顶层引用 spec-types.json 的共享类型。",
  "version": "v1",

  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^v(0|[1-9]\\d*)(-[a-z][a-z0-9]*)?$"
    },
    "idRef": {
      "type": "integer",
      "minimum": 0,
      "description": "非负整数 ID，对应 commonTypes.xsd 的 IDType。"
    },

    "corpusSchema": {
      "type": "object",
      "description": "索引条目（语料级），对应 fulltextIndex.xsd 的 corpus（corpDocType）：ID/name/description + document*。",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/idRef" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "documents": {
          "type": "array",
          "description": "语料内文档清单（0 个或多个），对应 document 元素（ID/name/description）。",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/idRef" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "metadata": {
      "type": "object",
      "description": "索引文档元信息。",
      "required": ["name", "version", "description", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "description": { "type": "string" },
        "scope": { "type": "string" }
      },
      "additionalProperties": false
    }
  },

  "type": "object",
  "description": "fulltext-index 文档顶层结构：语料索引列表。",
  "required": ["$schema", "$id", "metadata", "corpora"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:fulltext-index:[a-z0-9-]+:v[0-9]+(-[a-z][a-z0-9]*)?$"
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "corpora": {
      "type": "array",
      "description": "语料索引列表（0 个或多个），对应 corpus 元素。",
      "items": { "$ref": "#/$defs/corpusSchema" }
    },
    "validation_rules": {
      "type": "array",
      "description": "文档级校验规则：corpus.id 全局唯一；document.id 在语料内唯一；corpus 名可在 full-text header 中解析。",
      "items": {
        "type": "object",
        "required": ["rule", "expression"],
        "properties": {
          "rule": { "type": "string" },
          "expression": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
