{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:struct:sentence:v1",
  "title": "sentence (v1) 句子标注结构",
  "description": "核心的标注数据结构",
  "version": "v1",
  "$defs": {
    "version": { "$ref": "urn:struct:specTypes:v1#/$defs/version" },
    "idRef": { "$ref": "urn:struct:specTypes:v1#/$defs/urn_ref" },
    "order": { "$ref": "urn:struct:specTypes:v1#/$defs/order_type" },
    "span": { "$ref": "urn:struct:specTypes:v1#/$defs/label_spanType" },
    "convention": { "$ref": "urn:struct:specTypes:v1#/$defs/convention" },
    "labelType": {
      "type": "object",
      "description": "标注标签，零实例化，对应 sentence.xsd 的 labelType。",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "start": { "$ref": "#/$defs/span" },
        "end": { "$ref": "#/$defs/span" },
        "itype": {
          "type": "string",
          "enum": ["APos", "CNI", "INI", "DNI", "INC"],
          "description": "标签类型，，零实例化，对应 labelType 的 itype 枚举。"
        },
        "fe_id": { "type": "integer", "description": "对应 labelType 的可选 feID。" },
        "c_by": { "type": "string", "description": "标注者，对应 labelType 的可选 cBy。" }
      },
      "additionalProperties": false
    },
    "layerType": {
      "type": "object",
      "description": "标注层，对应 sentence.xsd 的 layerType（name 必填 + rank 可选 + label*）。",
      "required": ["name", "labels"],
      "properties": {
        "name": { 
          "type": "string",
          "description": "常见标注层：Target FE GF PT NER",
          "enum": ["Target", "FE", "GF", "PT", "NER"] 
        },
        "rank": { "$ref": "#/$defs/order" },
        "labels": {
          "type": "array",
          "description": "本层的标签清单（0 个或多个）。",
          "items": { "$ref": "#/$defs/labelType" }
        }
      },
      "additionalProperties": false
    },

    "annotationSetType": {
      "type": "object",
      "description": "标注集，对应 sentence.xsd 的 annotationSetType：layer* + 一组可选属性（ID/status/frameName/frameID/luName/luID/cxnName/cxnID/cDate）。",
      "required": ["layers"],
      "properties": {
        "id": { "$ref": "#/$defs/idRef" },
        "status": { "type": "string" },
        "frame_name": { "type": "string" },
        "frame_id": { "$ref": "#/$defs/idRef" },
        "lu_name": { "type": "string" },
        "lu_id": { "$ref": "#/$defs/idRef" },
        "cxn_name": { "type": "string" },
        "cxn_id": { "$ref": "#/$defs/idRef" },
        "c_date": {
          "type": "string",
          "pattern": "^\\d{2}/\\d{2}/\\d{4} \\d{2}:\\d{2}:\\d{2} [A-Z]{3} (Sun|Mon|Tue|Wed|Thu|Fri|Sat)$",
          "description": "标注时间，对应 dateTimeType 的 %c 格式。"
        },
        "layers": {
          "type": "array",
          "description": "层清单（1 个或多个）。",
          "items": { "$ref": "#/$defs/layerType" }
        }
      },
      "additionalProperties": false
    },

    "sentenceType": {
      "type": "object",
      "description": "单句标注，对应 sentence.xsd 的 sentenceType：text + annotationSet* + 一组可选定位属性。供 full-text / lex-unit 等 schema $ref 复用。",
      "required": ["text", "annotation_sets"],
      "properties": {
        "id": { "$ref": "#/$defs/idRef" },
        "a_pos": { "type": "integer", "minimum": 0, "description": "外部句引用，对应 extSentRefType。" },
        "parag_no": { "$ref": "#/$defs/order" },
        "sent_no": { "$ref": "#/$defs/order" },
        "doc_id": { "$ref": "#/$defs/idRef" },
        "corp_id": { "$ref": "#/$defs/idRef" },
        "external_id": { "type": "string" },
        "text": { "type": "string", "description": "句子文本，对应 sentence.xsd 的 text 元素。" },
        "annotation_sets": {
          "type": "array",
          "description": "标注集清单（0 个或多个）。",
          "items": { "$ref": "#/$defs/annotationSetType" }
        }
      },
      "additionalProperties": false
    },

    "metadata": { "$ref": "urn:struct:specTypes:v1#/$defs/metadata" }
  },

  "type": "object",
  "description": "sentence 文档顶层结构：单句的文本与全部标注信息，同时作为内部类型被 full-text / lex-unit 引用。",
  "required": ["$schema", "$id", "metadata", "sentence", "validation_rules", "conventions"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:sentence:[a-z0-9-]+:v[0-9]+(-[a-z][a-z0-9]*)?$"
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "sentence": { "$ref": "#/$defs/sentenceType" },
    "validation_rules": {
      "type": "array",
      "description": "文档级校验规则：label 的 start/end 不越界；annotation_set.frame_name 与 frame_id 须一致且可解析；c_date 采用 %c 时间格式。",
      "items": {
        "type": "object",
        "required": ["rule", "expression"],
        "properties": {
          "rule": { "type": "string" },
          "expression": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "conventions": {
      "type": "array",
      "description": "命名/格式约定清单，供作者对齐风格。",
      "items": { "$ref": "#/$defs/convention" }
    }
  },
  "additionalProperties": false
}
