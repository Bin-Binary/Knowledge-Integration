{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frame:F-ACTIVITY-00:v1-draft",  
  "metadata": {
    "frame_schema_id": "F-ACTIVITY-00",
    "frame_schema_name": "F-ACTIVITY",
    "parent": null,
    "definition": "刻画施事参与一项活动。引入施事，但不预设意向性（可是有意的，也可以是无意的习惯性行为）",
    "type": "frame",
    "version": "v1-draft",
    "external_refs": [
      {
        "target_schema_id": "ENT-HUMAN-00",
        "source_file": "ENTITY/ENT-HUMAN-00.json",
        "source_version": "v1-draft",
        "imported_at": "2026-09-10"
      },
      {
        "target_schema_id": "ENT-VERSION-GATE-01",
        "source_file": "ENTITY/gate/ENT-VERSION-GATE-01.json",
        "source_version": "v1-draft",
        "imported_at": "2026-09-10"
      }
    ]
  },

  "core_fe": {
    "Agent": {
      "semantic_role": "Agent",
      "constraint": {
        "type": { "$ref": "#/$defs/entity/human_entity" },
        "fillers": ["human_entity.instance_template.properties"]
      }
    },
    "action": {
        "constraint": { 
        "type": { "$ref": "#/$defs/entity/human_entity" },
        "fillers": ["human_entity.instance_template.properties"]
      }
    },
    "version": {
      "semantic_role": "patient",
      "constraint": {"$ref": "#/$defs/entity/version_entity"}
    },
    "intent": {
      "semantic_role": "purpose",
      "definition": "Agent意图通过action达成为了的未来状态、事件或结果",
      "constraint": {
        "type": {
          "frame": [
            {"$ref": "#/$defs/frame/state_frame"},
            {"$ref": "#/$defs/frame/event_frame"}
          ],
          "semantic_role": ["goal"]
        },
        "fillers": {},
        "default": {},
        "multi_candidate":{}
      }
    },
    "means": {
      "semantic_role": "purpose",
      "definition": "Agent施事为实现Purpose而采用的方法、行动、工具或过程",
      "constraint": {
        "type": {
          "frame": [
            {"$ref": "#/$defs/frame/event"},
            {"$ref": "#/$defs/frame/instrument"},
            {"$ref": "#/$defs/frame/resource"}            
          ]
        },
        "fillers": {},
        "default": {},
        "multi_candidate":{}
      }
    }
  },
  "peripheral_fe": {
    "condition": {
      "type": "string",
      "description": "控制依赖：仅当此条件满足时才执行本子图（如'版本分支已创建'、'规则集已配置'）。由父图读取，作为条件边的判定依据。"
    },
    "required_deps": {
      "type": "list[frame_project_id|result]",
      "description": "数据依赖：本子图输入所依赖的前序子图/帧实例的 result 产出（如[quality_gate_compile_schema.result, repository_snapshot.result]）。由父图负责顺序编排与输配，禁止隐式耦合。"
    },
    "source": {
      "type": "entity_id",
      "target_schema_id": "01_02_gate_version_schema",
      "description": "来源：从哪个前序版本复制/演进门禁配置（如从V800R001C30演进到V800R001C50）"
    },
    "goal": {
      "type": "entity_id",
      "target_schema_id": "01_03_gate_repository_schema",
      "description": "目标：门禁作用在哪个代码仓上"
    },
    "manner": {
      "type": "string",
      "enum": ["copy_from_previous", "create_from_scratch", "ai_assisted"],
      "description": "方式：从旧版本复制 / 从零创建 / AI辅助生成"
    },
    "result": {
      "type": "list[physical_file_id]",
      "target_schema_id": "04_physical_file_schema",
      "description": "结果：门禁配置落实到哪些物理文件（如[business/gns/cp/gns_oceanstor_pacific_9920.yml, ...]）"
    }
  },
  "lus": ["create", "gate", "product", "version"],

  "$defs":{
    "entity": {
      "human_entity": {"target_schema_id": "ENT-HUMAN-00"},
      "version_entity": {"target_schema_id": "ENT-VERSION-GATE-01"}
    },
    "frame": {
      "state_frame": {"target_schema_id": "ENT-HUMAN-00"},
      "event_frame": {"target_schema_id": "ENT-VERSION-GATE-01"}
    },
    "semantic_role": {

    }

  }

}
