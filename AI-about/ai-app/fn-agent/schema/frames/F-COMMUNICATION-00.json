{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frame:F-COMMUNICATION-00:v1-draft",
  "metadata": {
    "frame_schema_id": "F-COMMUNICATION-00",
    "frame_schema_name": "F-COMMUNICATION",
    "parent_frame_schema_id": null,
    "definition": "刻画发送方向接收方传递信息。",
    "type": "frame",
    "version": "v1-draft",
    "external_refs": [
      {
        "target_schema_id": "R-ROLES-00",
        "source_file": "./R-ROLES-00.json",
        "source_version": "v1-draft",
        "imported_at": "2026-09-15",
        "usage": "引用 AgentRole、MediumType"
      },
      {
        "target_schema_id": "system-queries",
        "source_file": "./system-queries.json",
        "source_version": "v1",
        "imported_at": "2026-09-15",
        "usage": "引用 current_user、default_recipient、notification.target、default_medium、notification.channel、default_language、user.language、event.result"
      }
    ]
  },

  "core_fe": {
    "communicator": {
      "definition": "发送信息的施事。",
      "required": true,
      "constraint": {
        "type": {
          "kind": "role",
          "ref": "AgentRole",
          "cardinality": "one",
          "note": "值域见 R-ROLES-00"
        },
        "fillers": {
          "sources": ["explicit", "context", "default", "frame"],
          "system_queries": ["current_user"],
          "frame_refs": [
            { "frame": "Intentionally_act", "fe": "agent" }
          ],
          "notes": "优先显式主语，其次从行动框架继承，最后默认当前用户"
        },
        "default": {
          "strategy": "use_default",
          "rule": "默认当前用户为发送方",
          "fallback": "ask",
          "assumptions": ["当前用户为发送方"]
        },
        "multi_candidate": {
          "strategy": "ask",
          "question_template": "是谁发送信息？",
          "options_source": "AgentRole.values",
          "max_options": 3,
          "fallback": "ask"
        }
      }
    },
    "addressee": {
      "definition": "接收信息的对象。",
      "required": true,
      "constraint": {
        "type": {
          "kind": "role",
          "ref": "AgentRole",
          "cardinality": "one",
          "note": "值域见 R-ROLES-00"
        },
        "fillers": {
          "sources": ["explicit", "context", "system"],
          "system_queries": ["default_recipient", "notification.target"],
          "notes": "优先显式宾语，其次从默认通知对象获取"
        },
        "default": {
          "strategy": "query_system",
          "rule": "查系统默认接收者或通知目标",
          "fallback": "ask"
        },
        "multi_candidate": {
          "strategy": "score",
          "ranking": ["explicit", "system", "history"],
          "threshold": 0.15,
          "question_template": "发送给谁？",
          "options_source": "AgentRole.values",
          "max_options": 3,
          "fallback": "ask"
        }
      }
    },
    "message": {
      "definition": "传递的信息内容。",
      "required": true,
      "constraint": {
        "type": {
          "kind": "primitive",
          "ref": "string",
          "cardinality": "one",
          "note": "文本信息，也可由 frame_refs 生成"
        },
        "fillers": {
          "sources": ["explicit", "frame", "inferred", "system"],
          "frame_refs": [
            { "frame": "State", "fe": "state" },
            { "frame": "Change", "fe": "final_state" },
            { "frame": "Processing_materials", "fe": "product" }
          ],
          "system_queries": ["event.result"],
          "notes": "优先显式信息内容，其次从上游框架结果生成"
        },
        "default": {
          "strategy": "infer",
          "rule": "从上下文或上游事件结果生成信息内容",
          "fallback": "ask"
        },
        "multi_candidate": {
          "strategy": "score",
          "ranking": ["explicit", "frame", "system"],
          "threshold": 0.2,
          "question_template": "信息内容是什么？",
          "max_options": 3,
          "fallback": "ask"
        }
      }
    }
  },

  "peripheral_fe": {
    "topic": {
      "definition": "信息所涉及的主题。",
      "required": false,
      "constraint": {
        "type": {
          "kind": "primitive",
          "ref": "string",
          "cardinality": "one"
        },
        "fillers": {
          "sources": ["explicit", "inferred", "frame"],
          "frame_refs": [
            { "frame": "Intentionally_act", "fe": "purpose" }
          ],
          "notes": "优先显式主题，其次从行动目的推断"
        },
        "default": {
          "strategy": "infer",
          "rule": "从信息内容或行动目的推断主题",
          "fallback": "ask"
        },
        "multi_candidate": {
          "strategy": "default_top1",
          "question_template": "主题是什么？",
          "max_options": 1,
          "fallback": "ask"
        }
      }
    },
    "medium": {
      "definition": "信息传递所使用的媒介。",
      "required": false,
      "constraint": {
        "type": {
          "kind": "role",
          "ref": "MediumType",
          "cardinality": "one",
          "note": "值域见 R-ROLES-00"
        },
        "fillers": {
          "sources": ["explicit", "system", "inferred"],
          "system_queries": ["default_medium", "notification.channel"],
          "notes": "优先显式媒介，其次查系统默认通知渠道"
        },
        "default": {
          "strategy": "query_system",
          "rule": "使用系统默认通知渠道",
          "fallback": "use_default",
          "assumptions": ["使用默认通知媒介"]
        },
        "multi_candidate": {
          "strategy": "score",
          "ranking": ["explicit", "system", "history"],
          "threshold": 0.15,
          "question_template": "通过什么媒介发送？",
          "options_source": "MediumType.values",
          "max_options": 3,
          "fallback": "ask"
        }
      }
    },
    "manner": {
      "definition": "信息传递的方式。",
      "required": false,
      "constraint": {
        "type": {
          "kind": "primitive",
          "ref": "string",
          "cardinality": "one"
        },
        "fillers": {
          "sources": ["explicit", "inferred"]
        },
        "default": {
          "strategy": "use_default",
          "rule": "使用默认方式",
          "fallback": "ask"
        },
        "multi_candidate": {
          "strategy": "default_top1",
          "question_template": "以什么方式发送？",
          "max_options": 1,
          "fallback": "ask"
        }
      }
    },
    "language": {
      "definition": "信息传递所使用的语言。",
      "required": false,
      "constraint": {
        "type": {
          "kind": "primitive",
          "ref": "string",
          "cardinality": "one"
        },
        "fillers": {
          "sources": ["explicit", "system", "inferred"],
          "system_queries": ["default_language", "user.language"]
        },
        "default": {
          "strategy": "query_system",
          "rule": "使用用户或系统默认语言",
          "fallback": "use_default",
          "assumptions": ["使用默认语言"]
        },
        "multi_candidate": {
          "strategy": "default_top1",
          "question_template": "使用什么语言？",
          "max_options": 1,
          "fallback": "ask"
        }
      }
    }
  },

  "lus": ["say", "tell", "speak", "communicate", "inform", "notify", "convey", "state"],
  "lus_zh": ["说", "告诉", "讲", "交流", "通知", "传达", "陈述", "告知"]
}