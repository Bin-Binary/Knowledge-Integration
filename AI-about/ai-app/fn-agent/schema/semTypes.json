{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:struct:semTypes:v1",
  "title": "semTypes (v1) 语义类型结构",
  "description": "语义类型的结构设计",
  "version": "v1",

  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^v(0|[1-9]\\d*)(-[a-z][a-z0-9]*)?$"
    },
    "superTypeRef": {
      "type": "object",
      "description": "父语义类型引用",
      "required": ["super_type_name", "sup_id"],
      "properties": {
        "super_type_name": { "type": "string", "minLength": 1 },
        "sup_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "semType": {
      "type": "object",
      "description": "单个语义类型",
      "required": ["id", "name", "abbrev", "definition"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "语义类型 ID"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9_-]*$",
          "description": "语义类型名（PascalCase）"
        },
        "abbrev": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9_-]*$",
          "description": "缩写，通常与 name 相同"
        },
        "definition": { "type": "string", "minLength": 1 },
        "super_types": {
          "type": "array",
          "description": "父类型层级（可多个）",
          "items": { "$ref": "#/$defs/superTypeRef" }
        },
        "applies_to": {
          "type": "array",
          "description": "适用层：语义类型可用在 frame / fe / lu 元素上",
          "items": {
            "type": "string",
            "enum": ["frame", "fe", "lu"]
          },
          "uniqueItems": true
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },

  "type": "object",
  "description": "semTypes 文档顶层结构：语义类型清单。",
  "required": ["$schema", "$id", "sem_types"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^urn:semTypes:[a-z0-9-]+:v[0-9]+(-[a-z][a-z0-9]*)?$"
    },
    "sem_types": {
      "type": "array",
      "description": "语义类型清单，对应 semTypes.xml 的 semType 元素序列。",
      "items": { "$ref": "#/$defs/semType" },
      "uniqueItems": true
    },
    "validation_rules": {
      "type": "array",
      "description": "文档级校验规则：name 全局唯一；super_types 中 sup_id 必须可解析；super_types 层级不允许成环。",
      "items": {
        "type": "object",
        "required": ["rule", "expression"],
        "properties": {
          "rule": { "type": "string" },
          "expression": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
