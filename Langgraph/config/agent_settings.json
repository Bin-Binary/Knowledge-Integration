{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 1,
    "reload": true,
    "log_level": "info",
    "cors_origins": ["*"],
    "request_timeout_seconds": 120.0,
    "enable_verbose_error_logs": true
  },
  "llm_profiles": {
    "intent": {
      "provider": "openai",
      "model_name": "GLM-V5.1",
      "temperature": 0.0,
      "max_tokens": 2048,
      "timeout_seconds": 60.0,
      "max_retries": 0,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false}
      }
    },
    "planner": {
      "provider": "openai",
      "model_name": "GLM-V5.1",
      "temperature": 0.1,
      "max_tokens": 4096,
      "timeout_seconds": 60.0,
      "max_retries": 2,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false}
      }
    },
    "executor": {
      "provider": "openai",
      "model_name": "GLM-V5.1",
      "temperature": 0.2,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 2,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false}
      }
    }
  },
  "intent_recognition": {
    "context_window_turns": 4,
    "confidence_threshold": 0.75
  },
    "internal_knowledge": {
    "enabled": true,
    "vault_root": "./data/llm_wiki",
    "workspace_root": ".",
    "quality_threshold": 0.5,
    "max_concurrency": 5
  }
}
