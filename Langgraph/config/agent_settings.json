{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 1,
    "reload": true,
    "log_level": "info",
    "cors_origins": ["*"],
    "request_timeout_seconds": 1200.0,
    "enable_verbose_error_logs": true
  },
  "llm_profiles": {
    "intent": {
      "provider": "openai",
      "model_name": "GLM-V5.1",
      "temperature": 0.0,
      "max_tokens": 1024,
      "timeout_seconds": 60.0,
      "max_retries": 1,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false},
        "repetition_penalty": 1.05
      }
    },
    "planner": {
      "provider": "openai",
      "model_name": "GLM-V5.1",
      "temperature": 0.5,
      "max_tokens": 4096,
      "timeout_seconds": 180.0,
      "max_retries": 2,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": true}
      }
    },
    "executor": {
      "provider": "openai",
      "model_name": "Tianzhou-Max",
      "temperature": 0.2,
      "max_tokens": 8192,
      "timeout_seconds": 600.0,
      "max_retries": 2,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": true}
      }
    },
    "knowledge": {
      "provider": "openai",
      "model_name": "Tianzhou-Max",
      "temperature": 0.0,
      "max_tokens": 8192,
      "timeout_seconds": 120.0,
      "max_retries": 3,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false}
      }
    },
    "recovery": {
      "provider": "openai",
      "model_name": "Tianzhou-Max",
      "temperature": 0.0,
      "max_tokens": 2048,
      "timeout_seconds": 30.0,
      "max_retries": 0,
      "bypass_proxy": true,
      "extra_body": {
        "chat_template_kwargs": {"enable_thinking": false}
      }
    }
  },
  "intent_recognition": {
    "context_window_turns": 4,
    "confidence_threshold": 0.75
  },
  "internal_knowledge": {
    "enabled": true,
    "vault_root": "D:\\code-repo\\ds-build\\llm-wiki",
    "workspace_root": "D:\\code-repo\\ds-build",
    "quality_threshold": 0.2,
    "max_concurrency": 4,
    "max_iterations": 1,
    "organize_timeout_seconds": 480.0
  },
  "exception_handling": {
    "max_error_length": 1000,
    "enable_sanitization": true,
    "max_failover_attempts": 1,
    "fallback_intent": "general_chat",
    "default_fallback_message": "抱歉，系统处理您的请求时遇到了一点小问题，请稍后再试。"
  }

}
